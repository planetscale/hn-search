# Direct (unpooled) connection string, used by drizzle-kit, the COPY seed, and pg_prewarm.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.c-3.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Shared secret for the /api/cron/sync route. Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` on scheduled invocations. Generate one with
# `openssl rand -hex 32`. If unset, the route is open (fine for local dev only).
CRON_SECRET=""