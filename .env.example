# What the pages read with. Everything they do is a SELECT, so a deployment
# reachable from the internet should hold a role with nothing but SELECT on
# `items`. The drizzle-kit, seed and backfill scripts read this too, and those
# need a role that can write.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.pg.psdb.cloud:5432/postgres?sslmode=verify-full&sslrootcert=system"

# What the hourly /api/cron/sync route writes with. Leave it unset to deploy a
# read-only copy: the corpus stops updating and nothing on the public internet
# holds a credential that can change the database.
DATABASE_URL_SYNC=""

# Shared secret for the /api/cron/sync route. Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` on scheduled invocations. Generate one with
# `openssl rand -hex 32`. Unset, the route refuses every request, so the sync
# only ever runs where a secret has been set deliberately.
CRON_SECRET=""